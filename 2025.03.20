% RC 충전 회로 시뮬레이션
clear all;
close all;

% 회로 파라미터 설정
R = 1000; % 저항 (옴), 1kΩ
C = 1e-6; % 커패시터 (패럿), 1μF
V0 = 5; % 전원 전압 (볼트)

% 시간 상수 계산
tau = R * C; % τ = RC

% 시간 벡터 생성
t = 0:0.0001:5*tau; % 0부터 5τ까지, 0.0001초 간격

% 충전 전압 계산 (V(t) = V0 * (1 - e^(-t/RC)))
Vc = V0 * (1 - exp(-t/tau));

% 그래프 그리기
figure('Name', 'RC 충전 회로');
plot(t, Vc, 'b-', 'LineWidth', 2);
grid on;

% 축 레이블과 제목 추가
xlabel('시간 (초)');
ylabel('커패시터 전압 (V)');
title('RC 회로 충전 곡선');

% 축 범위 설정
axis([0 5*tau 0 V0*1.1]);

% 시간 상수 표시
hold on;
plot([tau tau], [0 V0], 'r--', 'LineWidth', 1); % τ 위치 표시
text(tau, V0*0.1, '\tau', 'Color', 'red');
hold off;

% 그래프 꾸미기
set(gca, 'FontSize', 12);
