Python Code
import serial # 시리얼 통신을 위한 라이브러리 가져오기

# 시리얼 포트 연결하기
ser = serial.Serial('/dev/ttyS0', 9600, timeout = 1) # '/dev/ttyS0'는 포트 위치, 9600은 통신 속도, timeout=1은 대기 시간

ser.write(b'The World') # 다른 기기로 보낼 메시지 준비 

# 다른 기기에서 오는 메시지 읽기 
data = ser.read(15) # 최대 15글자까지 읽어올 수 있음

print(data) # 받은 메시지 화면에 출력하기

ser.close() # 포트 닫기

